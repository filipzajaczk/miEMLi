# Skopiuj do .env i uzupełnij. Plik .env nigdy nie trafia do repo.

# Django
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=https://localhost
SECURE_COOKIES=1

# Host, pod którym Caddy wystawia miemli
MIEMLI_HOST=localhost

# Baza i kolejka
POSTGRES_PASSWORD=
DATABASE_URL=postgres://miemli:HASLO_Z_POSTGRES_PASSWORD@postgres/miemli
REDIS_URL=redis://redis:6379/0

# Domeny firmy pomijane w IOC (po przecinku), np. firma.pl,firma.local
MIEMLI_IGNOROWANE_DOMENY=
